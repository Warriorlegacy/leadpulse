# Copy to .env and fill in. ALL values here are placeholders; never commit real secrets.

# HTTP port injected by the hosting platform. Locally defaults to 3000.
PORT=3000

# SQLite file location. Directory is created on boot.
DATA_DIR=./data
DB_FILE=./data/leadpulse.db

# Seeds a clearly labelled demo workspace with synthetic data on first boot.
# Set to "false" before putting any real customer data into this instance.
ALLOW_DEMO=true

# Public origin used when building capture-form links. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# ---- Optional providers. The core product works with all of these unset. ----
# These are adapter placeholders only. No email, AI, payment, Meta or WhatsApp
# integration is active in this build. Supplying a key here does NOT enable one.
RESEND_API_KEY=
EMAIL_FROM=
GEMINI_API_KEY=
META_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_TOKEN=

# ---- Cloudflare deployment (NOT configured; needs your account credentials) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
